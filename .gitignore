.Rproj.user
.Rhistory
.RData
.Ruserdata

/.quarto/
**/*.quarto_ipynb
/_site/
.positai

# macOS Finder metadata. Not anchored to the root: Finder writes one into any
# directory it has been asked to display, so a bare `.DS_Store` catches the
# copies under img/, data/ and icons/ as well as the one at the top.
.DS_Store

# ---------------------------------------------------------------------------
# Answer keys must NEVER be committed. See MAINTENANCE.md section 4. Keys live
# in the private companion repo; these rules are a backstop for the case where
# one is drafted or rendered inside this working copy by mistake.
# ---------------------------------------------------------------------------
# Source files...
*_key.qmd
*_Key.qmd
**/keys/

# ...and every rendered artifact derived from them. The .qmd rule alone is NOT
# enough: quarto writes the fully rendered answers into _freeze/ and _site/,
# which would otherwise be committed.
*_key.*
*_Key.*
*_key/
*_Key/

# archive/ is legacy source excluded from the render (see _quarto.yml). Nothing
# under it should ever be frozen or published.
_freeze/archive/

# ---------------------------------------------------------------------------
# Course readings that are copyrighted textbook chapters must never be
# committed here -- this repo is public and is published to GitHub Pages. Link
# to an open-access source, or leave the file to the course LMS. See
# MAINTENANCE.md section 5.
# ---------------------------------------------------------------------------
*.pdf
*.epub
*.docx
*.pptx
readings/

# Output of tools/measure-slides.mjs: a measurement of the last render, not
# something to keep. Regenerate it rather than reading a stale copy.
/tools/report.json
